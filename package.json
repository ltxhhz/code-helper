{
  "name": "ltxhhz-code-helper",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "code helper",
    "code",
    "helper",
    "backslash",
    "quote",
    "反斜杠",
    "引号"
  ],
  "publisher": "ltxhhz",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "code-helper.replaceBackslashMaxLines": {
          "type": "number",
          "default": 10,
          "description": "%config.maxLines.description%",
          "minimum": 0
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/ltxhhz/code-helper/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ltxhhz/code-helper"
  },
  "homepage": "https://github.com/ltxhhz/code-helper",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.70.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
